{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true,
    "paths": {
      "corkboard": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "demo",
    "vite.config.ts",
    "vite.demo.config.ts",
    "vite.worker.config.ts"
  ]
}
