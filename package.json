{
  "name": "corkboard",
  "version": "0.1.0",
  "description": "An infinite canvas of media cards on WebGL: culling, LOD textures, video overlays, auto layout and snapping.",
  "license": "MIT",
  "author": "Niccolò Fanton",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/corkboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/corkboard.js"
    },
    "./decode.worker": "./dist/decode.worker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && vite build --config vite.worker.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "rbush": "^4.0.1",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/rbush": "^4.0.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
