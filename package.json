{
  "name": "@niccolofanton/corkboard",
  "version": "0.2.0",
  "description": "An infinite canvas of media cards on WebGL: culling, LOD textures, video overlays, auto layout and snapping.",
  "license": "MIT",
  "author": "Niccolò Fanton",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "infinite-canvas",
    "moodboard",
    "webgl",
    "pixijs",
    "pixi",
    "canvas",
    "whiteboard",
    "iframe",
    "embeds",
    "lod",
    "masonry",
    "culling",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niccolofanton/corkboard.git"
  },
  "homepage": "https://corkboard.niccolofanton.dev",
  "bugs": {
    "url": "https://github.com/niccolofanton/corkboard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/corkboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/corkboard.js"
    },
    "./unstable": {
      "types": "./dist/unstable.d.ts",
      "import": "./dist/unstable.js"
    },
    "./decode.worker.js": {
      "types": "./dist/decode.worker.d.ts",
      "default": "./dist/decode.worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && vite build && vite build --config vite.worker.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir .types && rollup -c rollup.dts.config.mjs && node scripts/copy-worker-types.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "check:package": "publint && attw --pack . --profile esm-only && node scripts/check-dist.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm test:e2e",
    "test:e2e": "pnpm build:e2e && playwright test"
  },
  "dependencies": {
    "rbush": "^4.0.1",
    "thumbhash": "^0.1.1"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/rbush": "^4.0.0",
    "jsdom": "^24.1.3",
    "pixi.js": "8.22.0",
    "publint": "^0.3.25",
    "rollup": "^4.65.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
